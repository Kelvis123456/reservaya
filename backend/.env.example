PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (datos relacionales: usuarios, canchas, horarios, reservas)
DATABASE_URL=postgres://reservaya:reservaya@localhost:5433/reservaya

# MongoDB (datos flexibles: reseñas, notificaciones)
MONGO_URL=mongodb://localhost:27017/reservaya

JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_IN=7d

# DSN del proyecto de Sentry (monitoreo de errores). Vacío/no seteada =
# Sentry.init() no hace nada, captureException() queda como no-op.
SENTRY_DSN=
